@model List<PropertyCardViewModel>
@{
    ViewData["Title"] = "Wishlist";
    ViewData["CanWishlist"] = true;
}
<h1 class="h3 fw-bold mb-4">Wishlist</h1>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-heart"></i>
        <h2 class="h5 text-dark mt-3">No saved stays yet</h2>
        <p>Tap the heart on any listing to save it here.</p>
        <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Explore stays</a>
    </div>
}
else
{
    <div class="property-grid">
        @foreach (var property in Model)
        {
            <partial name="_PropertyCard" model="property" view-data="ViewData" />
        }
    </div>
}
