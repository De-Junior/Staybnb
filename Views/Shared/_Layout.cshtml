@inject Staybnb.Services.IUnreadCounter Unread
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isGuest = User.IsInRole(Roles.Guest);
    var isHost = User.IsInRole(Roles.Host);
    var isAdmin = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin);
    var counts = await Unread.GetAsync(User);
    var fullName = Fmt.FullName(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} | Staybnb" : "Staybnb")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-body">
    <header class="site-header">
        <nav class="container-xl d-flex align-items-center justify-content-between gap-3">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-heart-fill"></i><span>staybnb</span>
            </a>

            <form class="search-pill d-none d-lg-flex" asp-controller="Home" asp-action="Index" method="get">
                <input name="city" placeholder="Anywhere" value="@Context.Request.Query["city"]" aria-label="City" />
                <span class="divider"></span>
                <select name="type" aria-label="Property type">
                    <option value="">Any type</option>
                    @foreach (var type in Enum.GetValues<PropertyType>())
                    {
                        <option value="@type" selected="@(Context.Request.Query["type"] == type.ToString())">@type</option>
                    }
                </select>
                <span class="divider"></span>
                <input name="guests" type="number" min="1" max="50" placeholder="Add guests" value="@Context.Request.Query["guests"]" aria-label="Guests" />
                <button type="submit" class="search-btn" aria-label="Search"><i class="bi bi-search"></i></button>
            </form>

            <div class="d-flex align-items-center gap-1 gap-md-2">
                @if (!signedIn || isGuest)
                {
                    @if (isGuest)
                    {
                        <a class="nav-link-pill d-none d-md-inline" asp-controller="HostApplications" asp-action="Status">Host Application Status</a>
                    }
                    <a class="nav-link-pill d-none d-md-inline" asp-controller="HostApplications" asp-action="Create">Become a Host</a>
                }
                else if (isHost)
                {
                    <a class="nav-link-pill d-none d-md-inline" asp-controller="Host" asp-action="Dashboard">Switch to hosting</a>
                }
                else if (isAdmin)
                {
                    <a class="nav-link-pill d-none d-md-inline" asp-controller="Admin" asp-action="Dashboard">Admin dashboard</a>
                }

                @if (signedIn)
                {
                    <a class="icon-btn" asp-controller="Messages" asp-action="Index" title="Messages">
                        <i class="bi bi-envelope"></i>
                        @if (counts.Messages > 0) { <span class="dot-badge">@counts.Messages</span> }
                    </a>
                    <a class="icon-btn" asp-controller="Notifications" asp-action="Index" title="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (counts.Notifications > 0) { <span class="dot-badge">@counts.Notifications</span> }
                    </a>
                }

                <div class="dropdown">
                    <button class="user-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <i class="bi bi-list"></i>
                        <span class="avatar-sm">
                            @if (signedIn)
                            {
                                <text>@Fmt.Initial(fullName)</text>
                            }
                            else
                            {
                                <i class="bi bi-person-fill"></i>
                            }
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                        @if (!signedIn)
                        {
                            <li><a class="dropdown-item fw-semibold" asp-controller="Account" asp-action="Register">Sign up</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="HostApplications" asp-action="Create">Become a Host</a></li>
                        }
                        else
                        {
                            <li class="px-3 py-2">
                                <div class="fw-semibold">@fullName</div>
                                <div class="small text-muted">@Fmt.RoleLabel(User)</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (isGuest)
                            {
                                <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index"><i class="bi bi-suitcase2 me-2"></i>My trips</a></li>
                                <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                                <li><a class="dropdown-item" asp-controller="HostApplications" asp-action="Status"><i class="bi bi-clipboard-check me-2"></i>Host application status</a></li>
                            }
                            @if (isHost)
                            {
                                <li><a class="dropdown-item" asp-controller="Host" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Host dashboard</a></li>
                            }
                            @if (isAdmin)
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-shield-lock me-2"></i>Admin dashboard</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope me-2"></i>Messages</a></li>
                            <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-xl py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-xl d-flex flex-wrap justify-content-between gap-2 small text-muted">
            <span>&copy; @DateTime.Now.Year Staybnb</span>
            <span>Prices shown in South African Rand (ZAR)</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
