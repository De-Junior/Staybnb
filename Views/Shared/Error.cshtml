@model string
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-emoji-frown display-3 text-brand"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request.</p>
    <p class="small text-muted">Request ID: <code>@Model</code></p>
    <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
