@inject Staybnb.Services.IUnreadCounter Unread
@{
    var isAdmin = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin);
    var isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    var counts = await Unread.GetAsync(User);
    var fullName = Fmt.FullName(User);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string c, params string[] actions) =>
        controller == c && (actions.Length == 0 || actions.Contains(action)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Staybnb @(isAdmin ? "Admin" : "Host")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="dash-body">
    <aside class="sidebar" id="sidebar">
        <a class="brand px-3" asp-controller="@(isAdmin ? "Admin" : "Host")" asp-action="Dashboard">
            <i class="bi bi-house-heart-fill"></i><span>staybnb</span>
            @if (!isAdmin) { <span class="brand-sub">host</span> }
        </a>

        <nav class="side-nav">
            @if (isAdmin)
            {
                <a class="@Active("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i>Dashboard</a>
                <a class="@Active("Admin", "Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill"></i>Users</a>
                <a class="@Active("Admin", "Applications", "ApplicationDetails")" asp-controller="Admin" asp-action="Applications"><i class="bi bi-file-earmark-text-fill"></i>Host Requests</a>
                <a class="@Active("Admin", "Bookings")" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-calendar-check-fill"></i>Bookings</a>
                <a class="@Active("Admin", "Properties")" asp-controller="Admin" asp-action="Properties"><i class="bi bi-house-fill"></i>Properties</a>
                <a class="@Active("Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope-fill"></i>Messages
                    @if (counts.Messages > 0) { <span class="side-badge">@counts.Messages</span> }</a>
                <a class="@Active("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell-fill"></i>Notifications
                    @if (counts.Notifications > 0) { <span class="side-badge">@counts.Notifications</span> }</a>
                <a class="@Active("Admin", "ActivityLogs")" asp-controller="Admin" asp-action="ActivityLogs"><i class="bi bi-clock-history"></i>Activity Logs</a>
            }
            else
            {
                <a class="@Active("Host", "Dashboard")" asp-controller="Host" asp-action="Dashboard"><i class="bi bi-pie-chart-fill"></i>Dashboard</a>
                <a class="@Active("Host", "Properties", "EditProperty", "CheckInProcess") @Active("HostApplications")" asp-controller="Host" asp-action="Properties"><i class="bi bi-house-fill"></i>My Properties</a>
                <a class="@Active("Host", "Bookings")" asp-controller="Host" asp-action="Bookings"><i class="bi bi-calendar-check-fill"></i>Booking Requests</a>
                <a class="@Active("Host", "CheckIns", "CheckInReview")" asp-controller="Host" asp-action="CheckIns"><i class="bi bi-person-vcard-fill"></i>Guest Check ins</a>
                <a class="@Active("Host", "Earnings")" asp-controller="Host" asp-action="Earnings"><i class="bi bi-cash-stack"></i>Earnings</a>
                <a class="@Active("Host", "Reviews")" asp-controller="Host" asp-action="Reviews"><i class="bi bi-star-fill"></i>Reviews</a>
                <a class="@Active("Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope-fill"></i>Messages
                    @if (counts.Messages > 0) { <span class="side-badge">@counts.Messages</span> }</a>
                <a class="@Active("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell-fill"></i>Notifications
                    @if (counts.Notifications > 0) { <span class="side-badge">@counts.Notifications</span> }</a>
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-globe2"></i>View site</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="logout"><i class="bi bi-box-arrow-left"></i>Logout</button>
            </form>
        </nav>
    </aside>

    <div class="dash-main">
        <header class="dash-topbar">
            <button class="icon-btn d-lg-none" type="button" data-toggle-sidebar aria-label="Toggle menu"><i class="bi bi-list"></i></button>
            <h1 class="dash-title">@ViewData["Title"]</h1>
            <div class="d-flex align-items-center gap-2">
                <a class="icon-btn" asp-controller="Messages" asp-action="Index" title="Messages">
                    <i class="bi bi-envelope-fill"></i>
                    @if (counts.Messages > 0) { <span class="dot-badge">@counts.Messages</span> }
                </a>
                <a class="icon-btn" asp-controller="Notifications" asp-action="Index" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (counts.Notifications > 0) { <span class="dot-badge">@counts.Notifications</span> }
                </a>
                <div class="dropdown">
                    <button class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar-sm">@Fmt.Initial(fullName)</span>
                        <span class="d-none d-sm-flex flex-column text-start lh-sm">
                            <span class="fw-semibold small">@fullName</span>
                            <span class="text-muted" style="font-size:.72rem">@Fmt.RoleLabel(User)</span>
                        </span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                        @if (isSuperAdmin)
                        {
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users" asp-route-role="@Roles.Guest"><i class="bi bi-person-up me-2"></i>Promote admins</a></li>
                        }
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-globe2 me-2"></i>Browse stays</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="dash-content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
