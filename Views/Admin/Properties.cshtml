@model List<HostProperty>
@{
    ViewData["Title"] = "Properties";
}

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-clean">
            <thead><tr><th>Property</th><th>Host</th><th>City</th><th>Type</th><th>Price</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">No properties</td></tr> }
                @foreach (var p in Model)
                {
                    var cover = p.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (cover is not null) { <img src="@cover.ImageUrl" class="thumb" alt="" /> }
                                <span class="fw-semibold">@p.Title</span>
                            </div>
                        </td>
                        <td>@p.Host.FullName</td>
                        <td>@p.City</td>
                        <td>@p.PropertyType</td>
                        <td class="text-nowrap">@Fmt.Money(p.PricePerNight)</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge-soft-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-soft-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end"><a class="btn btn-soft btn-sm" asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
