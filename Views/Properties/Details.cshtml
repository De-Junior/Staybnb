@model PropertyDetailsViewModel
@{
    var p = Model.Property;
    ViewData["Title"] = p.Title;
    var images = p.Images.OrderBy(i => i.DisplayOrder).ToList();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h3 fw-bold mb-1">@p.Title</h1>
        <div class="text-muted small">
            <i class="bi bi-geo-alt-fill"></i> @p.City, @p.Country
            <span class="mx-2">&middot;</span><i class="bi bi-star-fill text-brand"></i> @Model.AverageRating.ToString("0.0") (@p.Reviews.Count review@(p.Reviews.Count == 1 ? "" : "s"))
        </div>
        @if (!p.IsActive)
        {
            <span class="badge-soft-warning mt-2">Not visible to guests (inactive or awaiting approval)</span>
        }
    </div>
    <div class="text-center">
        <span class="avatar-lg">@Fmt.Initial(p.Host.FirstName)</span>
        <div class="small fw-semibold mt-1">@p.Host.FullName</div>
        <span class="host-badge">Verified Host</span>
    </div>
</div>

@if (images.Count > 0)
{
    <div class="photo-mosaic @(images.Count == 1 ? "single" : "") mb-4">
        <img class="main" src="@images[0].ImageUrl" alt="@p.Title" />
        @foreach (var img in images.Skip(1).Take(2))
        {
            <img src="@img.ImageUrl" alt="@p.Title" />
        }
    </div>
}

<div class="row g-5">
    <div class="col-lg-7">
        <div class="pb-4 border-bottom">
            <h2 class="h5 fw-bold">@p.PropertyType hosted by @p.Host.FirstName</h2>
            <div class="text-muted">
                <i class="bi bi-people"></i> @p.MaxGuests guests &middot;
                <i class="bi bi-door-closed"></i> @p.Bedrooms bedroom@(p.Bedrooms == 1 ? "" : "s") &middot;
                <i class="bi bi-hospital"></i> @p.Beds bed@(p.Beds == 1 ? "" : "s") &middot;
                <i class="bi bi-droplet"></i> @p.Bathrooms bath@(p.Bathrooms == 1 ? "" : "s")
            </div>
        </div>

        <div class="py-4 border-bottom">
            <p class="mb-0" style="white-space:pre-line">@p.Description</p>
        </div>

        @if (p.Amenities.Count > 0)
        {
            <div class="py-4 border-bottom">
                <h2 class="h5 fw-bold mb-3">What this place offers</h2>
                <div class="row">
                    @foreach (var a in p.Amenities.OrderBy(a => a.Name))
                    {
                        <div class="col-sm-6 amenity"><i class="bi @(a.IconClass ?? "bi-check2")"></i>@a.Name</div>
                    }
                </div>
            </div>
        }

        <div class="py-4 border-bottom">
            <h2 class="h5 fw-bold mb-2">Where you'll be</h2>
            <p class="text-muted mb-0"><i class="bi bi-map"></i> @p.Address, @p.City, @p.Country</p>
        </div>

        <div class="py-4">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-star-fill text-brand"></i> @Model.AverageRating.ToString("0.0") &middot; @p.Reviews.Count review@(p.Reviews.Count == 1 ? "" : "s")</h2>
            @if (p.Reviews.Count == 0)
            {
                <p class="text-muted">No reviews yet.</p>
            }
            <div class="row g-4">
                @foreach (var r in p.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="initials">@Fmt.Initials(r.Reviewer.FirstName, r.Reviewer.LastName)</span>
                            <div>
                                <div class="fw-semibold small">@r.Reviewer.FirstName</div>
                                <div class="text-muted" style="font-size:.75rem">@Fmt.Date(r.CreatedAt)</div>
                            </div>
                        </div>
                        <div class="small text-brand">@for (var i = 0; i < r.Rating; i++) { <i class="bi bi-star-fill"></i> }</div>
                        <p class="small mb-0">@r.Comment</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="booking-card" data-booking-widget
             data-price="@p.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-cleaning="@p.CleaningFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-fee-rate="@Model.ServiceFeeRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-max-guests="@p.MaxGuests">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><span class="h4 fw-bold">@Fmt.Money(p.PricePerNight)</span> <span class="text-muted">/ night</span></div>
                @if (User.IsInRole(Roles.Guest))
                {
                    <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                        <input type="hidden" name="propertyId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path)" />
                        <button class="icon-btn" title="Wishlist"><i class="bi @(Model.IsWishlisted ? "bi-heart-fill text-brand" : "bi-heart")"></i></button>
                    </form>
                }
            </div>

            <form asp-controller="Bookings" asp-action="Create" method="post">
                <input type="hidden" name="PropertyId" value="@p.Id" />
                <div class="date-box mb-3">
                    <div class="row g-0">
                        <div class="col-6 border-end">
                            <label for="CheckInDate">Check in</label>
                            <input type="date" id="CheckInDate" name="CheckInDate" min="@today" value="@Model.Booking.CheckInDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label for="CheckOutDate">Checkout</label>
                            <input type="date" id="CheckOutDate" name="CheckOutDate" min="@today" value="@Model.Booking.CheckOutDate.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="border-top px-3 py-2 d-flex justify-content-between align-items-center">
                        <div><label class="mb-0">Guests</label><span class="small text-muted">Max @p.MaxGuests</span></div>
                        <div class="stepper">
                            <button type="button" data-step="-1" aria-label="Fewer guests">&minus;</button>
                            <input name="NumberOfGuests" value="@Model.Booking.NumberOfGuests" readonly aria-label="Guests" />
                            <button type="button" data-step="1" aria-label="More guests">+</button>
                        </div>
                    </div>
                </div>

                @if (Model.CanBook)
                {
                    <button type="submit" class="btn btn-brand w-100 py-2">Request to book</button>
                    <p class="text-center small text-muted mt-2 mb-0">You won't be charged until the host approves</p>
                }
                else if (!signedIn)
                {
                    <a class="btn btn-brand w-100 py-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in to book</a>
                }
                else if (Model.IsOwner)
                {
                    <a class="btn btn-soft w-100" asp-controller="Host" asp-action="EditProperty" asp-route-id="@p.Id">Edit your listing</a>
                }
                else
                {
                    <div class="alert alert-light border small mb-0">Only Guest accounts can book stays.</div>
                }
            </form>

            <div data-breakdown hidden class="mt-3">
                <div class="price-line"><span data-nights-label></span><span data-subtotal></span></div>
                <div class="price-line"><span>Cleaning fee</span><span data-cleaning></span></div>
                <div class="price-line"><span>Service fee (@((Model.ServiceFeeRate * 100).ToString("0"))%)</span><span data-fee></span></div>
                <div class="price-total"><span>Total</span><span data-total></span></div>
            </div>

            @if (Model.BookedRanges.Count > 0)
            {
                <div class="mt-3 small">
                    <div class="fw-semibold mb-1"><i class="bi bi-calendar-x"></i> Already booked</div>
                    @foreach (var (from, to) in Model.BookedRanges.Take(6))
                    {
                        <div class="text-muted">@Fmt.Date(from) to @Fmt.Date(to)</div>
                    }
                </div>
            }
        </div>

        @if (signedIn && !Model.IsOwner)
        {
            <div class="text-center mt-3">
                <a class="btn btn-soft" asp-controller="Messages" asp-action="Index" asp-route-with="@p.HostId"><i class="bi bi-chat-dots"></i> Message the host</a>
            </div>
        }
    </div>
</div>
