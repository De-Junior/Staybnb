@model List<Booking>
@{
    ViewData["Title"] = "Booking Requests";
    var current = ViewBag.Status as BookingStatus?;
    var pending = (int)ViewBag.PendingCount;
}

<div class="filter-pills mb-3">
    <a class="@(current == null ? "active" : "")" asp-action="Bookings">All</a>
    @foreach (var s in Enum.GetValues<BookingStatus>())
    {
        <a class="@(current == s ? "active" : "")" asp-action="Bookings" asp-route-status="@s">
            @s @if (s == BookingStatus.Pending && pending > 0) { <span class="badge rounded-pill text-bg-danger ms-1">@pending</span> }
        </a>
    }
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-clean">
            <thead>
                <tr><th>Guest</th><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th><th>Check in</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-5">No bookings found</td></tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="initials">@Fmt.Initials(b.Guest.FirstName, b.Guest.LastName)</span>
                                <div><div class="fw-semibold">@b.Guest.FullName</div><div class="small text-muted">@b.Guest.Email</div></div>
                            </div>
                        </td>
                        <td>@b.Property.Title</td>
                        <td class="text-nowrap">@Fmt.Date(b.CheckInDate)<br /><span class="small text-muted">to @Fmt.Date(b.CheckOutDate)</span></td>
                        <td>@b.NumberOfGuests</td>
                        <td class="text-nowrap">@Fmt.Money(b.TotalPrice)</td>
                        <td><span class="@Fmt.Badge(b.Status)">@b.Status</span></td>
                        <td>
                            @if (b.GuestCheckIn is not null)
                            {
                                <a asp-action="CheckInReview" asp-route-id="@b.GuestCheckIn.Id" class="@Fmt.Badge(b.GuestCheckIn.Status) text-decoration-none">@b.GuestCheckIn.Status</a>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (b.Status == BookingStatus.Pending)
                            {
                                <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                                    <button class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approve</button>
                                </form>
                                <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post" class="d-inline" data-confirm="Reject this booking request?">
                                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-x-lg"></i> Reject</button>
                                </form>
                            }
                            else if (b.Status == BookingStatus.CheckedIn)
                            {
                                <form asp-action="CompleteBooking" asp-route-id="@b.Id" method="post" class="d-inline" data-confirm="Mark this stay as completed?">
                                    <button class="btn btn-soft btn-sm"><i class="bi bi-flag"></i> Complete stay</button>
                                </form>
                            }
                            <a class="btn btn-soft btn-sm" asp-controller="Messages" asp-action="Index" asp-route-with="@b.GuestId" title="Message guest"><i class="bi bi-chat-dots"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
