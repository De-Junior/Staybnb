@model List<HostPropertyRowViewModel>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-brand" asp-controller="HostApplications" asp-action="Create"><i class="bi bi-plus-lg"></i> Add New Property</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state panel"><i class="bi bi-house"></i><p class="mt-2">You have no properties yet.</p></div>
}

<div class="d-flex flex-column gap-3">
    @foreach (var row in Model)
    {
        var p = row.Property;
        var cover = p.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();
        <div class="listing-row">
            <div class="d-flex flex-column flex-md-row">
                <div class="position-relative m-3">
                    @if (cover is not null)
                    {
                        <img src="@cover.ImageUrl" class="thumb-lg" alt="@p.Title" />
                    }
                    <span class="photo-count"><i class="bi bi-camera"></i> @p.Images.Count</span>
                </div>
                <div class="body flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <h2 class="h6 fw-bold mb-1">@p.Title</h2>
                            <div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @p.City, @p.Country</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-brand">@Fmt.Money(p.PricePerNight, 2)<span class="text-muted small fw-normal">/night</span></div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <span class="spec"><i class="bi bi-people"></i> @p.MaxGuests guests</span>
                        <span class="spec"><i class="bi bi-door-closed"></i> @p.Bedrooms bedrooms</span>
                        <span class="spec"><i class="bi bi-hospital"></i> @p.Beds beds</span>
                        <span class="spec"><i class="bi bi-droplet"></i> @p.Bathrooms bathrooms</span>
                    </div>
                    <div class="mt-2 d-flex gap-2 flex-wrap">
                        <span class="badge-soft-info">@p.PropertyType</span>
                        @if (!row.IsApproved)
                        {
                            <span class="@Fmt.Badge(row.LatestApplicationStatus ?? ApplicationStatus.Pending)">Application @(row.LatestApplicationStatus ?? ApplicationStatus.Pending)</span>
                        }
                        else if (p.IsActive)
                        {
                            <span class="badge-soft-success"><i class="bi bi-check-circle-fill"></i> Active</span>
                        }
                        else
                        {
                            <span class="badge-soft-secondary">Inactive</span>
                        }
                    </div>
                </div>
            </div>
            <div class="foot">
                <div class="small text-muted">
                    <i class="bi bi-calendar"></i> @row.BookingCount booking@(row.BookingCount == 1 ? "" : "s")
                    <span class="ms-3"><i class="bi bi-star"></i> @(row.ReviewCount == 0 ? "No reviews" : $"{row.AverageRating:0.0} ({row.ReviewCount})")</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-soft btn-sm" asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye"></i> View Details</a>
                    <a class="btn btn-soft btn-sm" asp-action="EditProperty" asp-route-id="@p.Id"><i class="bi bi-pencil-square"></i> Edit</a>
                    <a class="btn btn-soft btn-sm" asp-action="CheckInProcess" asp-route-propertyId="@p.Id"><i class="bi bi-list-check"></i> Check in process</a>
                    @if (row.IsApproved)
                    {
                        <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post">
                            @if (p.IsActive)
                            {
                                <button class="btn btn-danger btn-sm"><i class="bi bi-pause-circle"></i> Deactivate</button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-sm"><i class="bi bi-play-circle"></i> Activate</button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
