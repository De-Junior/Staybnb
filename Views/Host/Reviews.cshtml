@model List<Review>
@{
    ViewData["Title"] = "Reviews";
}

@if (Model.Count == 0)
{
    <div class="empty-state panel"><i class="bi bi-star"></i><p class="mt-2 mb-0">No reviews yet. Guests can leave a review after they check in.</p></div>
}

<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-6">
            <div class="panel h-100">
                <div class="d-flex justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="initials">@Fmt.Initials(r.Reviewer.FirstName, r.Reviewer.LastName)</span>
                        <div>
                            <div class="fw-semibold">@r.Reviewer.FullName</div>
                            <div class="small text-muted">@r.Property.Title &middot; @Fmt.Date(r.CreatedAt)</div>
                        </div>
                    </div>
                    <div class="text-brand text-nowrap">@for (var i = 0; i < r.Rating; i++) { <i class="bi bi-star-fill"></i> }</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(r.Comment))
                {
                    <p class="mt-3 mb-0">@r.Comment</p>
                }
            </div>
        </div>
    }
</div>
